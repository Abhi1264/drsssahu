---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import { site } from "../config/site";
import { primaryEmail, visibleEmails, visiblePhones } from "../utils/content";
import { pageSeo } from "../utils/seo";
import { pageJsonLd } from "../utils/jsonld";
import { externalLinkAttrs } from "../utils/links";

const seo = pageSeo("contact");
const emails = visibleEmails();
const phones = visiblePhones();
const jsonLd = pageJsonLd("/contact", [{ name: "Contact", path: "/contact" }]);
---

<BaseLayout title={seo.title} description={seo.description} canonicalPath="/contact" jsonLd={jsonLd}>
  <Container class="py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Contact" }]} />
    <PageHeader title={site.contact.heading} description={site.contact.intro} />
    <div class="mt-10 grid gap-12 md:grid-cols-2">
      <section>
        <h2 class="font-serif text-2xl text-ink">Department</h2>
        <address class="mt-4 not-italic leading-relaxed text-ink-soft">
          {site.person.addressLines.map((line) => (
            <p>{line}</p>
          ))}
        </address>
        {site.contact.mapUrl && (
          <p class="mt-4 text-sm">
            <a href={site.contact.mapUrl} {...externalLinkAttrs(site.contact.mapUrl)}>BIT Mesra on OpenStreetMap</a>
          </p>
        )}
      </section>
      <section>
        <h2 class="font-serif text-2xl text-ink">Email</h2>
        <ul class="mt-4 space-y-2">
          {emails.map((item) => (
            <li>
              <a href={`mailto:${item.address}`} class="inline-flex min-h-11 items-center break-all md:min-h-0">{item.address}</a>
              <span class="text-sm text-muted"> · {item.label}</span>
            </li>
          ))}
        </ul>
        {phones.length > 0 && (
          <div class="mt-8">
            <h2 class="font-serif text-2xl text-ink">Telephone</h2>
            <ul class="mt-4 space-y-2">
              {phones.map((item) => (
                <li>
                  <a href={item.href} class="inline-flex min-h-11 items-center md:min-h-0">{item.number}</a>
                  <span class="text-sm text-muted"> · {item.label}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    </div>
    <section class="mt-14">
      <h2 class="font-serif text-2xl text-ink">Research profiles</h2>
      <div class="mt-4 text-ink-soft">
        <ProfileLinks />
      </div>
    </section>
    <p class="mt-12 text-sm">
      <a href={`mailto:${primaryEmail()}`}>{site.ui.email}</a>
      ·
      <a href="/resume">{site.resume.downloadLabel}</a>
    </p>
  </Container>
</BaseLayout>
