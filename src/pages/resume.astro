---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site } from "../config/site";
import { pageSeo } from "../utils/seo";
import { pageJsonLd } from "../utils/jsonld";

const seo = pageSeo("resume");
const jsonLd = pageJsonLd("/resume", [
  { name: "Curriculum vitae", path: "/resume" },
]);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/resume"
  jsonLd={jsonLd}
>
  <Container class="py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Curriculum vitae" }]} />
    <PageHeader title={site.resume.heading} description={site.resume.intro} />
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={site.resume.file} download class="btn-primary">
        <span>{site.resume.downloadLabel}</span>
        <span class="btn-icon-circle" aria-hidden="true">↓</span>
      </a>
      <a
        href={site.resume.file}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost"
      >
        Open PDF in new tab ↗
      </a>
    </div>
    <iframe
      src={site.resume.file}
      title={`Curriculum Vitae of ${site.person.name}`}
      loading="lazy"
      class="panel mt-6 h-[80vh] min-h-152 w-full"
    ></iframe>
  </Container>
</BaseLayout>
