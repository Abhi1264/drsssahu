---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site } from "../config/site";
import { pageSeo } from "../utils/seo";
import { pageJsonLd } from "../utils/jsonld";
import { externalLinkAttrs } from "../utils/links";

const seo = pageSeo("resume");
const jsonLd = pageJsonLd("/resume", [
  { name: "Curriculum vitae", path: "/resume" },
]);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/resume"
  jsonLd={jsonLd}
>
  <Container class="py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Curriculum vitae" }]} />
    <PageHeader title={site.resume.heading} description={site.resume.intro} />
    <p class="mt-10">
      <a
        href={site.resume.file}
        {...externalLinkAttrs(site.resume.file)}
        data-astro-reload
        class="btn-primary">{site.resume.downloadLabel}</a
      >
    </p>
  </Container>
</BaseLayout>
