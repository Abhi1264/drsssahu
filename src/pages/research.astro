---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ResearchTheme from "../components/ResearchTheme.astro";
import { site } from "../config/site";
import { visibleItems } from "../utils/content";
import { pageSeo } from "../utils/seo";
import { pageJsonLd } from "../utils/jsonld";

const seo = pageSeo("research");
const themes = visibleItems(site.research.themes);
const jsonLd = pageJsonLd("/research", [{ name: "Research", path: "/research" }]);
---

<BaseLayout title={seo.title} description={seo.description} canonicalPath="/research" jsonLd={jsonLd}>
  <Container class="py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Research" }]} />
    <PageHeader
      title="Research"
      description="Research interests and themes drawn from the publication, project, and supervision record."
    />
    <section class="mt-10">
      <h2 class="font-serif text-2xl text-ink">Research interests</h2>
      <ul class="mt-4 max-w-xl space-y-2 text-lg text-ink-soft">
        {site.research.interests.map((interest) => (
          <li>{interest}</li>
        ))}
      </ul>
    </section>
    <section class="mt-14">
      <h2 class="mb-2 font-serif text-2xl text-ink">Research themes</h2>
      {themes.map((theme) => (
        <ResearchTheme theme={theme} />
      ))}
    </section>
    <p class="mt-12 text-sm">
      <a href="/publications">Publications</a>
      ·
      <a href="/projects">Projects</a>
    </p>
  </Container>
</BaseLayout>
