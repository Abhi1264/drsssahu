---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site } from "../config/site";
import { visibleItems } from "../utils/content";
import { externalLinkAttrs } from "../utils/links";
import { researchImage } from "../utils/logos";
import { pageSeo } from "../utils/seo";
import { pageJsonLd } from "../utils/jsonld";

const seo = pageSeo("research");
const themes = visibleItems(site.research.themes);
const highlights = site.research.highlights;
const jsonLd = pageJsonLd("/research", [
  { name: "Research", path: "/research" },
]);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/research"
  jsonLd={jsonLd}
>
  <Container class="py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Research" }]} />
    <PageHeader
      title="Research"
      description="Core research domains, public-domain bioinformatics tools, time-frequency signal processing methodologies, and patented hardware systems."
    />

    <!-- Research Interests Strip -->
    <ul class="flex flex-wrap gap-2 pb-12">
      {
        site.research.interests.map((interest) => (
          <li class="chip">{interest}</li>
        ))
      }
    </ul>

    <!-- Sticky Split-Screen: 6 Research Domains -->
    <section
      aria-labelledby="domains-heading"
      class="border-t border-rule pt-12 md:pt-16"
    >
      <div class="grid items-start gap-10 lg:grid-cols-[20rem_1fr] lg:gap-14">
        <div class="lg:sticky lg:top-28">
          <span class="mark mb-4"></span>
          <p class="text-xs tracking-[0.18em] text-signal uppercase">
            Research Themes
          </p>
          <h2
            id="domains-heading"
            class="mt-2 text-3xl leading-[1.15] text-ink"
          >
            Six interconnected <em class="italic text-signal">tracks</em>
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">
            Bridging time-frequency digital signal processing, machine learning, computational proteomics, biophotonics, and embedded cyber-physical systems.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          {
            themes.map((theme, index) => {
              const img = researchImage(theme.image);
              return (
                <article class="panel panel-hover flex flex-col overflow-hidden">
                  {img && (
                    <Image
                      src={img}
                      alt={theme.title}
                      width={640}
                      height={360}
                      densities={[1.5, 2]}
                      loading={index < 2 ? "eager" : "lazy"}
                      decoding="async"
                      class="aspect-video w-full object-cover"
                    />
                  )}
                  <div class="flex flex-1 flex-col justify-between p-5 md:p-6">
                    <div>
                      <h3 class="text-xl leading-snug text-ink md:text-2xl">
                        {theme.title}
                      </h3>
                      <p class="mt-3 text-sm leading-relaxed text-ink-soft md:text-base">
                        {theme.description}
                      </p>
                    </div>
                    {theme.methods && theme.methods.length > 0 && (
                      <ul class="mt-5 flex flex-wrap gap-1.5 border-t border-rule pt-4">
                        {theme.methods.map((method) => (
                          <li class="chip text-xs">{method}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Sticky Split-Screen: Public-Domain Tools, Web Servers & Translational Systems -->
    <section
      aria-labelledby="systems-heading"
      class="mt-16 border-t border-rule pt-12 md:mt-24 md:pt-16"
    >
      <div class="grid items-start gap-10 lg:grid-cols-[20rem_1fr] lg:gap-14">
        <div class="lg:sticky lg:top-28">
          <span class="mark mb-4"></span>
          <p class="text-xs tracking-[0.18em] text-signal uppercase">
            Public-Domain Deliverables
          </p>
          <h2
            id="systems-heading"
            class="mt-2 text-3xl leading-[1.15] text-ink"
          >
            Web servers, <em class="italic text-signal">algorithms</em> &amp; patented devices
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">
            Verifiable software tools, molecular interaction predictors, and clinical/agricultural hardware developed across NIT Rourkela, Oklahoma State University, and BIT Mesra.
          </p>
        </div>

        <ul class="grid gap-5 sm:grid-cols-2">
          {
            highlights.map((item) => {
              const isExternal = item.url.startsWith("http");
              return (
                <li class="panel panel-hover flex flex-col justify-between p-6">
                  <div>
                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs tabular-nums">
                      <span class="rounded-full bg-navy px-2.5 py-0.5 font-semibold text-white">
                        {item.metric}
                      </span>
                      <span class="text-muted">{item.year}</span>
                    </div>
                    <h3 class="mt-3 text-xl leading-snug text-ink">
                      {item.title}
                    </h3>
                    <p class="mt-1 text-xs font-medium text-signal">
                      {item.subtitle}
                    </p>
                    <p class="mt-3 text-sm leading-relaxed text-ink-soft">
                      {item.description}
                    </p>
                  </div>
                  <div class="mt-5 border-t border-rule pt-3.5">
                    <a
                      href={item.url}
                      {...(isExternal ? externalLinkAttrs(item.url) : {})}
                      class="text-xs font-semibold tracking-wider text-navy uppercase no-underline hover:underline"
                    >
                      {isExternal ? "Open DOI / Public Record ↗" : "View Publication →"}
                    </a>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <div class="mt-16 flex flex-wrap gap-3">
      <a href="/publications" class="btn-primary">
        <span>Browse Publications</span>
        <span class="btn-icon-circle" aria-hidden="true">→</span>
      </a>
      <a href="/projects" class="btn-ghost">Funded Projects</a>
      <a href="/patents" class="btn-ghost">Patents &amp; Designs</a>
    </div>
  </Container>
</BaseLayout>
