---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import PageHeader from "../../components/PageHeader.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PublicationList from "../../components/PublicationList.astro";
import PublicationFilters from "../../components/PublicationFilters.astro";
import PublicationTypeNav from "../../components/PublicationTypeNav.astro";
import { site } from "../../config/site";
import { allPublications, publicationYears } from "../../utils/content";
import { pageSeo } from "../../utils/seo";
import { pageJsonLd } from "../../utils/jsonld";

const seo = pageSeo("publications");
const publications = allPublications();
const jsonLd = pageJsonLd(
  "/publications",
  [{ name: "Publications", path: "/publications" }],
  {
    name: "Publications",
    numberOfItems: publications.length,
  },
);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/publications"
  jsonLd={jsonLd}
>
  <Container class="py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Publications" }]} />
    <PageHeader
      title="Publications"
      description={`Selected and complete research publications. ${site.publications.journals.length} journal articles, ${site.publications.conferences.length} conference papers, and ${site.publications.bookChapters.length} book chapters.`}
    />
    <PublicationTypeNav current="all" />
    <div class="mt-6">
      <PublicationFilters
        years={publicationYears(publications)}
        types={[
          { value: "journal", label: site.ui.typeJournal },
          { value: "conference", label: site.ui.typeConference },
          { value: "book-chapter", label: site.ui.typeBook },
        ]}
      />
      <PublicationList publications={publications} />
    </div>
  </Container>
</BaseLayout>
