---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import PageHeader from "../../components/PageHeader.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PublicationList from "../../components/PublicationList.astro";
import PublicationFilters from "../../components/PublicationFilters.astro";
import PublicationTypeNav from "../../components/PublicationTypeNav.astro";
import { publicationYears, publicationsByType } from "../../utils/content";
import { pageSeo } from "../../utils/seo";
import { pageJsonLd } from "../../utils/jsonld";

const seo = pageSeo("books");
const publications = publicationsByType("book-chapter");
const jsonLd = pageJsonLd(
  "/publications/books",
  [
    { name: "Publications", path: "/publications" },
    { name: "Book chapters", path: "/publications/books" },
  ],
  { name: "Book chapters", numberOfItems: publications.length },
);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/publications/books"
  jsonLd={jsonLd}
>
  <Container class="py-12 md:py-16">
    <Breadcrumbs
      items={[
        { label: "Publications", href: "/publications" },
        { label: "Book chapters" },
      ]}
    />
    <PageHeader
      title="Book chapters"
      description={`${publications.length} book chapters.`}
    />
    <PublicationTypeNav current="books" />
    <div class="mt-6">
      <PublicationFilters
        years={publicationYears(publications)}
        showType={false}
      />
      <PublicationList publications={publications} />
    </div>
  </Container>
</BaseLayout>
