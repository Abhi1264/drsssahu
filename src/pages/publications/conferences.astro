---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import PageHeader from "../../components/PageHeader.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PublicationList from "../../components/PublicationList.astro";
import PublicationFilters from "../../components/PublicationFilters.astro";
import PublicationTypeNav from "../../components/PublicationTypeNav.astro";
import { publicationYears, publicationsByType } from "../../utils/content";
import { pageSeo } from "../../utils/seo";
import { pageJsonLd } from "../../utils/jsonld";

const seo = pageSeo("conferences");
const publications = publicationsByType("conference");
const jsonLd = pageJsonLd(
  "/publications/conferences",
  [
    { name: "Publications", path: "/publications" },
    { name: "Conferences", path: "/publications/conferences" },
  ],
  { name: "Conference publications", numberOfItems: publications.length },
);
---

<BaseLayout title={seo.title} description={seo.description} canonicalPath="/publications/conferences" jsonLd={jsonLd}>
  <Container class="py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Publications", href: "/publications" }, { label: "Conferences" }]} />
    <PageHeader title="Conference publications" description={`${publications.length} conference proceedings.`} />
    <PublicationTypeNav current="conferences" />
    <div class="mt-6">
      <PublicationFilters years={publicationYears(publications)} showType={false} />
      <PublicationList publications={publications} />
    </div>
  </Container>
</BaseLayout>
