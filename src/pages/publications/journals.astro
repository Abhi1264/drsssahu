---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import PageHeader from "../../components/PageHeader.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PublicationList from "../../components/PublicationList.astro";
import PublicationFilters from "../../components/PublicationFilters.astro";
import PublicationTypeNav from "../../components/PublicationTypeNav.astro";
import { publicationYears, publicationsByType } from "../../utils/content";
import { pageSeo } from "../../utils/seo";
import { pageJsonLd } from "../../utils/jsonld";

const seo = pageSeo("journals");
const publications = publicationsByType("journal");
const jsonLd = pageJsonLd(
  "/publications/journals",
  [
    { name: "Publications", path: "/publications" },
    { name: "Journals", path: "/publications/journals" },
  ],
  { name: "Journal publications", numberOfItems: publications.length },
);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/publications/journals"
  jsonLd={jsonLd}
>
  <Container class="py-12 md:py-16">
    <Breadcrumbs
      items={[
        { label: "Publications", href: "/publications" },
        { label: "Journals" },
      ]}
    />
    <PageHeader
      title="Journal publications"
      description={`${publications.length} international journal articles.`}
    />
    <PublicationTypeNav current="journals" />
    <div class="mt-6">
      <PublicationFilters
        years={publicationYears(publications)}
        showType={false}
      />
      <PublicationList publications={publications} />
    </div>
  </Container>
</BaseLayout>
