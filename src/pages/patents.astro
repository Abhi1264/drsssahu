---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PatentEntry from "../components/PatentEntry.astro";
import { site } from "../config/site";
import { pageSeo } from "../utils/seo";
import { pageJsonLd } from "../utils/jsonld";

const seo = pageSeo("patents");
const patents = site.patents;
const jsonLd = pageJsonLd("/patents", [{ name: "Patents", path: "/patents" }], {
  name: "Patents and intellectual property",
  numberOfItems: patents.length,
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/patents"
  jsonLd={jsonLd}
>
  <Container class="py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Patents" }]} />
    <PageHeader
      title="Patents and intellectual property"
      description="Granted patents, published applications, and design registrations across India and the United Kingdom."
    />
    <div class="mt-8">
      {patents.map((patent) => <PatentEntry patent={patent} />)}
    </div>
  </Container>
</BaseLayout>
