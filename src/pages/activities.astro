---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site } from "../config/site";
import { visibleItems } from "../utils/content";
import { pageSeo } from "../utils/seo";
import { pageJsonLd } from "../utils/jsonld";

const seo = pageSeo("activities");
const jsonLd = pageJsonLd("/activities", [
  { name: "Activities", path: "/activities" },
]);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/activities"
  jsonLd={jsonLd}
>
  <Container class="py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Activities" }]} />
    <PageHeader
      title="Professional activities"
      description="Awards, fellowships, professional service, and workshops listed in the curriculum vitae."
    />

    <section class="mt-12">
      <h2 class="text-2xl font-medium text-ink">Awards and distinctions</h2>
      <ul class="mt-4 space-y-3">
        {
          visibleItems(site.awards).map((item) => (
            <li class="panel p-5">
              <p class="text-ink">{item.title}</p>
              <p class="mt-1 text-sm text-muted">
                {[item.organization, item.date].filter(Boolean).join(" · ")}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-medium text-ink">
        Fellowships and scholarships
      </h2>
      <ul class="mt-4 space-y-3">
        {
          visibleItems(site.fellowships).map((item) => (
            <li class="panel p-5">
              <p class="text-ink">{item.title}</p>
              <p class="mt-1 text-sm text-muted">
                {item.organization} · {item.date}
              </p>
              {item.description && (
                <p class="mt-2 text-sm text-ink-soft">{item.description}</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-medium text-ink">Professional service</h2>
      <ul class="mt-4 space-y-3">
        {
          visibleItems(site.professionalActivities).map((item) => (
            <li class="panel p-5">
              <p class="text-ink">{item.activity}</p>
              <p class="mt-1 text-sm text-muted">
                {[item.organization, item.date].filter(Boolean).join(" · ")}
              </p>
              {item.description && (
                <p class="mt-2 text-sm text-ink-soft">{item.description}</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-medium text-ink">Workshops organised</h2>
      <ul class="mt-4 space-y-3">
        {
          visibleItems(site.workshops).map((item) => (
            <li class="panel p-5">
              <p class="text-ink">{item.title}</p>
              <p class="mt-1 text-sm text-muted">
                {[item.date, item.location, item.sponsor]
                  .filter(Boolean)
                  .join(" · ")}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</BaseLayout>
