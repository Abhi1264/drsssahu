---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import { site } from "../config/site";
import { visibleItems } from "../utils/content";
import { pageSeo } from "../utils/seo";
import { pageJsonLd } from "../utils/jsonld";

const seo = pageSeo("projects");
const projects = visibleItems(site.projects);
const jsonLd = pageJsonLd("/projects", [{ name: "Projects", path: "/projects" }]);
---

<BaseLayout title={seo.title} description={seo.description} canonicalPath="/projects" jsonLd={jsonLd}>
  <Container class="py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Projects" }]} />
    <PageHeader title="Funded research projects" description={`${projects.length} completed projects listed in the curriculum vitae, all as principal investigator.`} />
    <div class="mt-8">
      {projects.map((project) => (
        <ProjectEntry project={project} />
      ))}
    </div>
  </Container>
</BaseLayout>
