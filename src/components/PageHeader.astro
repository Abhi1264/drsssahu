---
type Props = {
  title: string;
  description?: string;
};

const { title, description } = Astro.props;
---

<header class="pb-8">
  <span class="mark mb-5"></span>
  <h1 class="max-w-4xl text-3xl leading-tight font-medium text-ink md:text-5xl">
    {title}
  </h1>
  {
    description && (
      <p class="mt-4 max-w-3xl text-pretty text-base leading-relaxed text-ink-soft md:text-[1.08rem]">
        {description}
      </p>
    )
  }
</header>
