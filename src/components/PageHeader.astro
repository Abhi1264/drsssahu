---
type Props = {
  title: string;
  description?: string;
};

const { title, description } = Astro.props;
---

<header class="border-b border-rule pb-8">
  <h1 class="max-w-4xl font-serif text-3xl leading-tight text-ink md:text-4xl">{title}</h1>
  {description && <p class="mt-4 max-w-3xl text-pretty text-base leading-relaxed text-ink-soft md:text-[1.05rem]">{description}</p>}
</header>
