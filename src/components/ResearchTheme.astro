---
import type { ResearchTheme } from "../config/types";

type Props = { theme: ResearchTheme };

const { theme } = Astro.props;
---

<article class="panel panel-hover mb-4 p-5 md:p-6">
  <h2 class="text-xl font-medium text-ink md:text-2xl">{theme.title}</h2>
  <p class="mt-3 max-w-3xl leading-relaxed text-ink-soft">{theme.description}</p>
</article>
