---
import type { Publication } from "../config/types";
import {
  bibliographicLine,
  externalSources,
  matchesAuthor,
  searchText,
  slugFor,
} from "../utils/content";

type Props = {
  publication: Publication;
};

const { publication } = Astro.props;
const slug = slugFor(publication);
const links = externalSources(publication);
---

<article
  class="publication-entry border-t border-rule py-6"
  data-publication
  data-year={publication.year}
  data-type={publication.type}
  data-search={searchText(publication)}
>
  <h3 class="max-w-4xl font-serif text-xl leading-snug text-ink md:text-[1.35rem]">
    <a href={`/publications/${slug}`} class="text-ink no-underline hover:underline">
      {publication.title}
    </a>
  </h3>
  <p class="mt-2 text-[0.98rem] leading-relaxed text-ink-soft">
    {publication.authors.map((author, index) => (
      <>
        <span class:list={matchesAuthor(author) ? "font-semibold text-navy" : undefined}>{author}</span>
        {index < publication.authors.length - 1 && <span class="text-muted"> · </span>}
      </>
    ))}
  </p>
  <p class="mt-2 text-sm text-muted">{bibliographicLine(publication)}</p>
  {publication.indexing && <p class="mt-1 text-sm text-muted">{publication.indexing}</p>}
  {publication.notes && <p class="mt-2 text-sm text-ink-soft">{publication.notes}</p>}
  {links.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {links.map((item) => (
        <li>
          <a href={item.url} rel="noopener noreferrer" class="break-all">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  )}
</article>
