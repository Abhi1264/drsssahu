---
import type { Patent } from "../config/types";
import { externalLinkAttrs } from "../utils/links";

type Props = { patent: Patent };

const { patent } = Astro.props;
const number = patent.patentNumber
  ? patent.kind === "design"
    ? `Design No. ${patent.patentNumber}`
    : `Patent No. ${patent.patentNumber}`
  : patent.applicationNumber
    ? `Application No. ${patent.applicationNumber}`
    : patent.publicationNumber
      ? `Publication No. ${patent.publicationNumber}`
      : "";
const links = (patent.sources ?? []).filter((item) => item.url);
---

<article class="panel mb-4 p-5 md:p-6">
  <p class="text-xs tracking-[0.16em] text-signal uppercase">
    {patent.country} · {patent.status} · {patent.kind}
  </p>
  <h2
    class="mt-2 max-w-4xl text-xl leading-snug font-medium text-ink md:text-2xl"
  >
    {patent.title}
  </h2>
  <p class="mt-3 text-sm text-ink-soft">
    {number}
    {patent.date ? ` · ${patent.date}` : ""}
  </p>
  {
    links.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-4 text-sm">
        {links.map((item) => (
          <li>
            <a href={item.url} {...externalLinkAttrs(item.url)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
