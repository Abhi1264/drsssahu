---
type Item = {
  href: string;
  label: string;
  id: "all" | "journals" | "conferences" | "books";
};

type Props = {
  current: Item["id"];
};

const { current } = Astro.props;
const items: Item[] = [
  { href: "/publications", label: "All", id: "all" },
  { href: "/publications/journals", label: "Journals", id: "journals" },
  {
    href: "/publications/conferences",
    label: "Conferences",
    id: "conferences",
  },
  { href: "/publications/books", label: "Book chapters", id: "books" },
];
---

<nav class="mt-8 flex flex-wrap gap-2 text-sm" aria-label="Publication types">
  {
    items.map((item) => (
      <a
        href={item.href}
        aria-current={current === item.id ? "page" : undefined}
        class="type-pill inline-flex min-h-11 items-center rounded-full border border-rule bg-surface px-3.5 text-ink-soft no-underline transition-colors hover:border-navy hover:text-navy md:min-h-0 md:py-2"
      >
        {item.label}
      </a>
    ))
  }
</nav>
