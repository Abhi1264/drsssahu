---
import { site } from "../config/site";
import { verifiedProfiles } from "../utils/content";
import Container from "./Container.astro";

const footerNav = site.footer.links.filter((item) => item.visible);
const profiles = verifiedProfiles();
---

<footer class="mt-20 border-t border-rule">
  <Container class="grid gap-10 py-12 md:grid-cols-3">
    <div>
      <p class="font-serif text-lg text-ink">{site.person.name}</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted">{site.footer.tagline}</p>
    </div>
    <nav aria-label="Footer">
      <ul class="space-y-2 text-sm">
        {footerNav.map((item) => (
          <li>
            <a href={item.href} class="text-ink-soft no-underline hover:text-navy hover:underline">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div>
      <p class="text-xs tracking-[0.16em] text-muted uppercase">Research profiles</p>
      <ul class="mt-3 space-y-2 text-sm">
        {profiles.map((item) => (
          <li>
            <a href={item.url} rel="noopener noreferrer" class="text-ink-soft no-underline hover:text-navy hover:underline">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>
  <div class="border-t border-rule">
    <Container class="py-5">
      <p class="text-sm text-muted">
        © {new Date().getFullYear()} {site.footer.copyrightName}
      </p>
    </Container>
  </div>
</footer>
