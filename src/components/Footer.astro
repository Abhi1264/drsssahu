---
import { site } from "../config/site";
import { primaryEmail } from "../utils/content";
import { identityLinkAttrs } from "../utils/links";
import Container from "./Container.astro";

const navItems = site.navigation;
const profiles = site.profiles;
const email = primaryEmail();

function iconFor(label: string) {
  const l = label.toLowerCase();
  if (l.includes("linkedin")) return "linkedin";
  if (l.includes("scholar")) return "scholar";
  if (l.includes("orcid")) return "orcid";
  if (l.includes("scopus")) return "scopus";
  if (l.includes("loop")) return "loop";
  return "external";
}
---

<footer
  class="mt-24 bg-navy pb-[env(safe-area-inset-bottom)] text-white"
  transition:name="site-footer"
  transition:persist="site-footer"
  transition:animate="none"
>
  <Container class="py-10">
    <!-- Top Callout & Socials Row -->
    <div class="grid gap-10 border-b border-white/15 pb-8 lg:grid-cols-[1.3fr_1fr] lg:items-end">
      <div>
        <p class="text-xs tracking-[0.2em] text-white/70 uppercase">
          Correspondence & Collaboration
        </p>
        <h2 class="mt-3 max-w-2xl font-serif text-3xl leading-[1.15] text-white md:text-5xl">
          Open to research collaboration, <em class="italic text-[#f2a663]">sponsored R&amp;D</em>, and doctoral supervision.
        </h2>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <a
          href={`mailto:${email}`}
          class="inline-flex min-h-12 items-center gap-3 rounded-full bg-surface py-1.5 pl-5 pr-2 text-sm font-semibold text-navy no-underline transition-transform hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:transform-none"
        >
          <span>{email}</span>
          <span class="inline-flex size-8 items-center justify-center rounded-full bg-navy text-white">
            <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 14 14 6m0 0H7.5M14 6v6.5" />
            </svg>
          </span>
        </a>
        <a
          href="/resume"
          class="inline-flex min-h-12 items-center rounded-full border border-white/25 px-5 text-sm font-semibold text-white no-underline transition-colors hover:border-white hover:bg-white/10"
        >
          Download CV (PDF)
        </a>
      </div>
    </div>

    <!-- Socials & Academic Profiles Pill Strip -->
    <div class="border-b border-white/15 py-8">
      <p class="text-xs tracking-[0.18em] text-white/65 uppercase">
        Socials, Scholarly Indices &amp; Institutional Profiles
      </p>
      <ul class="mt-4 flex flex-wrap gap-2.5">
        {
          profiles.map((item) => {
            const kind = iconFor(item.label);
            return (
              <li>
                <a
                  href={item.url}
                  {...identityLinkAttrs(item.url)}
                  class="inline-flex min-h-10 items-center gap-2 rounded-full border border-white/20 bg-white/8 px-4 py-1.5 text-sm text-white no-underline transition-colors hover:border-white/50 hover:bg-white/16"
                >
                  {kind === "linkedin" && (
                    <svg class="size-4 text-[#f2a663]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z" />
                    </svg>
                  )}
                  {kind === "scholar" && (
                    <svg class="size-4 text-[#f2a663]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 3 1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3Zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9ZM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72Z" />
                    </svg>
                  )}
                  {kind === "orcid" && (
                    <svg class="size-4 text-[#f2a663]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm-3.25 5.5c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1Zm.75 9.5h-1.5v-6.5h1.5V17Zm4.75 0h-3v-6.5h3c2.07 0 3.5 1.32 3.5 3.25S16.32 17 14.25 17Zm-.15-5.2h-1.35v3.9h1.35c1.25 0 2.05-.75 2.05-1.95s-.8-1.95-2.05-1.95Z" />
                    </svg>
                  )}
                  {(kind === "scopus" || kind === "loop" || kind === "external") && (
                    <svg class="size-3.5 text-[#f2a663]" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 14 14 6m0 0H7.5M14 6v6.5" />
                    </svg>
                  )}
                  <span>{item.label}</span>
                  {item.identifier && (
                    <span class="text-xs text-white/60" translate="no">({item.identifier})</span>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <!-- Directory Grid -->
    <div class="grid gap-10 pt-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-serif text-2xl text-white">{site.person.name}</p>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-white/75">
          {site.person.designation}, {site.person.department}, {site.person.institution}, {site.person.location} – {site.person.postalCode}.
        </p>
        <p class="mt-3 text-sm tabular-nums text-white/75">
          Office: {site.person.phones[0]?.number} · Residence: {site.person.phones[1]?.number}
        </p>
      </div>

      <nav aria-label="Footer navigation">
        <p class="text-xs tracking-[0.18em] text-white/65 uppercase">Navigation</p>
        <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-white/85 no-underline hover:text-white hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="text-xs tracking-[0.18em] text-white/65 uppercase">
          Machine-Readable &amp; Feeds
        </p>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href="/rss.xml" class="text-white/85 no-underline hover:text-white hover:underline">
              Publications RSS Feed
            </a>
          </li>
          <li>
            <a href="/publications.json" class="text-white/85 no-underline hover:text-white hover:underline">
              Structured Publications JSON
            </a>
          </li>
          <li>
            <a href="/profile.json" class="text-white/85 no-underline hover:text-white hover:underline">
              Schema.org Person JSON-LD
            </a>
          </li>
          <li>
            <a href="/llms-full.txt" class="text-white/85 no-underline hover:text-white hover:underline">
              Complete Academic Record (llms-full.txt)
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col justify-between gap-4 border-t border-white/15 pt-6 text-xs text-white/65 sm:flex-row sm:items-center">
      <p>
        © {new Date().getFullYear()} {site.footer.copyrightName}. All rights reserved.
      </p>
      <p>
        Birla Institute of Technology Mesra · Ranchi, India
      </p>
    </div>
  </Container>
</footer>
