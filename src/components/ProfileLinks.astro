---
import { verifiedProfiles } from "../utils/content";
import { identityLinkAttrs } from "../utils/links";

const profiles = verifiedProfiles();
---

{profiles.length > 0 && (
  <ul class="flex flex-wrap gap-2">
    {profiles.map((item) => (
      <li>
        <a href={item.url} {...identityLinkAttrs(item.url)} class="chip">
          {item.label}
          {item.identifier ? ` (${item.identifier})` : ""}
        </a>
      </li>
    ))}
  </ul>
)}
