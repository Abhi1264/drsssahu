---
import { verifiedProfiles } from "../utils/content";
import { externalLinkAttrs } from "../utils/links";

const profiles = verifiedProfiles();
---

{profiles.length > 0 && (
  <ul class="space-y-1">
    {profiles.map((item) => (
      <li>
        <a href={item.url} {...externalLinkAttrs(item.url)} class="inline-flex min-h-11 items-center md:min-h-0 md:py-1">
          {item.label}
          {item.identifier ? ` (${item.identifier})` : ""}
        </a>
      </li>
    ))}
  </ul>
)}
