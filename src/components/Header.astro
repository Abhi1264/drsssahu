---
import { site } from "../config/site";
import { visibleNavigation } from "../utils/content";
import { externalLinkAttrs } from "../utils/links";
import Container from "./Container.astro";

const items = visibleNavigation();
const current = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-rule/80 bg-paper/80 pt-[env(safe-area-inset-top)] backdrop-blur-md"
  transition:name="site-header"
>
  <Container class="flex items-center justify-between gap-6 py-3.5 md:py-4">
    <a href="/" class="min-w-0 text-ink no-underline hover:text-navy">
      <span class="block font-serif text-[1.15rem] leading-tight tracking-tight md:text-xl">{site.person.shortName}</span>
      <span class="mt-0.5 block text-[0.68rem] tracking-[0.16em] text-muted uppercase">{site.person.institutionShort}</span>
    </a>
    <input
      id="nav-toggle"
      type="checkbox"
      class="peer sr-only lg:hidden"
      aria-controls="primary-nav"
      aria-expanded="false"
      aria-label={site.ui.menuOpen}
      data-open-label={site.ui.menuOpen}
      data-close-label={site.ui.menuClose}
    />
    <label
      for="nav-toggle"
      class="inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full text-ink hover:bg-surface hover:text-navy peer-focus-visible:outline peer-focus-visible:outline-offset-2 peer-focus-visible:outline-navy peer-checked:[&_.icon-menu]:hidden peer-checked:[&_.icon-close]:block lg:hidden"
    >
      <span class="sr-only">{site.ui.menuOpen}</span>
      <svg class="icon-menu size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="icon-close hidden size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18" />
      </svg>
    </label>
    <nav
      id="primary-nav"
      aria-label="Primary"
      class="absolute left-0 right-0 top-[4.55rem] z-40 hidden max-h-[min(70vh,32rem)] overflow-y-auto overscroll-contain border-b border-rule bg-paper/95 px-5 py-4 backdrop-blur-md peer-checked:block lg:static lg:z-auto lg:block lg:max-h-none lg:overflow-visible lg:border-0 lg:bg-transparent lg:px-0 lg:py-0 lg:backdrop-blur-none"
    >
      <ul class="flex flex-col gap-1 lg:flex-row lg:flex-nowrap lg:justify-end lg:gap-x-4 xl:gap-x-5">
        {items.map((item) => {
          const active = item.href === "/" ? current === "/" : current === item.href || current.startsWith(`${item.href}/`);
          return (
            <li>
              <a
                href={item.href}
                {...externalLinkAttrs(item.href)}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "nav-link inline-flex min-h-11 items-center text-[0.92rem] lg:min-h-0 lg:text-[0.88rem] xl:text-[0.95rem]",
                  active ? "font-semibold text-navy" : "text-ink-soft hover:text-navy",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </Container>
</header>

<script>
  let menuAbort: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    menuAbort?.abort();
    menuAbort = new AbortController();
    const { signal } = menuAbort;
    const toggle = document.querySelector<HTMLInputElement>("#nav-toggle");
    if (!toggle) return;
    const label = document.querySelector<HTMLLabelElement>("label[for='nav-toggle']");
    const openLabel = label?.querySelector(".sr-only");
    const openText = toggle.dataset.openLabel ?? "Open menu";
    const closeText = toggle.dataset.closeLabel ?? "Close menu";
    const sync = () => {
      const open = toggle.checked;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? closeText : openText);
      if (openLabel) openLabel.textContent = open ? closeText : openText;
    };
    toggle.addEventListener("change", sync, { signal });
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape" || !toggle.checked) return;
        toggle.checked = false;
        toggle.dispatchEvent(new Event("change"));
        toggle.focus();
      },
      { signal },
    );
    sync();
  });

  document.addEventListener("astro:before-swap", () => {
    const toggle = document.querySelector<HTMLInputElement>("#nav-toggle");
    if (toggle) toggle.checked = false;
  });
</script>
