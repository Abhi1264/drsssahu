---
import { externalLinkAttrs } from "../utils/links";

type Props = {
  title: string;
  href?: string;
  linkLabel?: string;
  id?: string;
};

const { title, href, linkLabel, id } = Astro.props;
---

<div
  class:list={[
    "mb-6",
    href && "flex flex-wrap items-end justify-between gap-3",
  ]}
>
  <div>
    <span class="mark mb-3"></span>
    <h2 id={id} class="text-2xl font-medium text-ink md:text-[1.75rem]">
      {title}
    </h2>
  </div>
  {
    href && (
      <a
        href={href}
        {...externalLinkAttrs(href)}
        class="inline-flex min-h-11 items-center text-sm md:min-h-0"
      >
        {linkLabel}
      </a>
    )
  }
</div>
