---
import { site } from "../config/site";

type Props = {
  years: number[];
  types?: { value: string; label: string }[];
  showType?: boolean;
};

const { years, types = [], showType = true } = Astro.props;
const { ui } = site;
---

<form
  class:list={[
    "publication-filters panel mb-10 grid gap-4 p-5",
    showType ? "md:grid-cols-[1fr_10rem_12rem]" : "md:grid-cols-[1fr_10rem]",
  ]}
  role="search"
  data-publication-filters
>
  <label class="block">
    <span class="mb-1 block text-xs tracking-[0.14em] text-muted uppercase"
      >{ui.searchPublications}</span
    >
    <input
      type="search"
      name="q"
      autocomplete="off"
      spellcheck="false"
      placeholder="Title, author, or venue…"
      class="input-field min-h-11 w-full px-3 py-2 text-ink"
    />
  </label>
  <label class="block">
    <span class="mb-1 block text-xs tracking-[0.14em] text-muted uppercase"
      >{ui.filterYear}</span
    >
    <select name="year" class="input-field min-h-11 w-full px-3 py-2 text-ink">
      <option value="">{ui.allYears}</option>
      {years.map((year) => <option value={year}>{year}</option>)}
    </select>
  </label>
  {
    showType && (
      <label class="block">
        <span class="mb-1 block text-xs tracking-[0.14em] text-muted uppercase">
          {ui.filterType}
        </span>
        <select
          name="type"
          class="input-field min-h-11 w-full px-3 py-2 text-ink"
        >
          <option value="">{ui.allTypes}</option>
          {types.map((type) => (
            <option value={type.value}>{type.label}</option>
          ))}
        </select>
      </label>
    )
  }
</form>
<p data-empty hidden class="text-ink-soft" role="status" aria-live="polite">
  {ui.noResults}
</p>

<script>
  function bindFilters(form: HTMLFormElement) {
    const root = form.closest("main") ?? document;
    const empty =
      form.parentElement?.querySelector<HTMLElement>("[data-empty]");
    const queryField = form.elements.namedItem("q");
    const yearField = form.elements.namedItem("year");
    const typeField = form.elements.namedItem("type");

    const apply = () => {
      const data = new FormData(form);
      const query = String(data.get("q") ?? "")
        .trim()
        .toLowerCase();
      const year = String(data.get("year") ?? "");
      const type = String(data.get("type") ?? "");
      const entries = root.querySelectorAll<HTMLElement>("[data-publication]");
      const sections = root.querySelectorAll<HTMLElement>(
        ".publication-list section",
      );
      let visible = 0;

      for (const entry of entries) {
        const show =
          (!query || (entry.dataset.search ?? "").includes(query)) &&
          (!year || entry.dataset.year === year) &&
          (!type || entry.dataset.type === type);
        entry.hidden = !show;
        if (show) visible += 1;
      }

      for (const section of sections) {
        section.hidden = !section.querySelector(
          "[data-publication]:not([hidden])",
        );
      }

      if (empty) empty.hidden = visible > 0;
    };

    const persist = () => {
      const data = new FormData(form);
      const next = new URL(location.href);
      for (const key of ["q", "year", "type"] as const) {
        const value = String(data.get(key) ?? "").trim();
        if (value) next.searchParams.set(key, value);
        else next.searchParams.delete(key);
      }
      history.replaceState(null, "", next);
    };

    const params = new URLSearchParams(location.search);
    if (queryField instanceof HTMLInputElement)
      queryField.value = params.get("q") ?? "";
    if (yearField instanceof HTMLSelectElement)
      yearField.value = params.get("year") ?? "";
    if (typeField instanceof HTMLSelectElement)
      typeField.value = params.get("type") ?? "";

    form.addEventListener("submit", (event) => event.preventDefault());
    form.addEventListener("input", () => {
      apply();
      persist();
    });
    apply();
  }

  const startFilters = () => {
    document
      .querySelectorAll<HTMLFormElement>("[data-publication-filters]")
      .forEach((form) => {
        if (form.dataset.bound === "true") return;
        form.dataset.bound = "true";
        bindFilters(form);
      });
  };

  startFilters();
  document.addEventListener("astro:page-load", startFilters);
</script>
