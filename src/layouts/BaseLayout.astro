---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";
import { absoluteUrl } from "../utils/seo";

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: string;
  jsonLd?: unknown[];
};

const { title, description, canonicalPath = Astro.url.pathname, ogType = "website", jsonLd = [] } = Astro.props;
const canonical = absoluteUrl(canonicalPath);
const ogImage = absoluteUrl(site.seo.defaultOgImage);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.person.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`Publications by ${site.person.name}`} href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.seo.siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={site.seo.locale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-3 focus:py-2 focus:text-sm"
    >
      {site.ui.skipToContent}
    </a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
